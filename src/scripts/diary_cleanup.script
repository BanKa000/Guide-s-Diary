--------------------------------------------------------------------------------
--' Дневник проводника: разовая очистка уровней от оригинального сюжета.
--' Идёт порциями по id (чтобы не было фриза), один раз на уровень; флаг - инфопорция.
--' Сюжет мода на уровне стартует только после done(level).
--------------------------------------------------------------------------------
local PORTION = 6000

--' names - объекты по имени; items - все предметы, лежащие на уровне (не в инвентаре, не артефакты);
--' hiding - заготовки тайников ("_hiding_")
local PURGE = {
	zaton = {
		flag = "diary_purged3", items = true, hiding = true,
		ids = {[53] = "level_prefix_inventory_box_0000"},
		names = {
			zat_b12_key_1_box = true, zat_b12_key_2_box = true, zat_b12_millitary_box = true,
			zat_b12_container = true, zaton_zat_b12_documents_2 = true,
			zat_b14_af_quest_b14_twisted = true, zat_b39_af_fuzz_kolobok = true,
			zat_b20_teleport_horiz = true, zat_b20_teleport = true, zat_b20_sr_teleport_mapspot = true,
			zat_b20_sr_actor_cross_the_teleport = true,
		},
	},
	jupiter = {
		flag = "diary_purged_jup", items = true,
		names = {
			jup_b10_secret_01 = true, jup_b10_secret_02 = true, jup_b10_secret_03 = true,
			jup_b202_actor_treasure = true, jup_b202_snag_treasure = true, jup_b47_jupiter_products_info = true,
		},
	},
}

--' предметы, которые нельзя трогать никогда
local KEEP_PREFIX = {"af_", "diary_", "dj_"}

local cur = 0
local cur_level = nil

local function keep_section(sec)
	for _, p in ipairs(KEEP_PREFIX) do
		if string.sub(sec, 1, #p) == p then return true end
	end
	return false
end

local function should_release(p, se, lid)
	if se.parent_id ~= 65535 then return false end
	if game_graph():vertex(se.m_game_vertex_id):level_id() ~= lid then return false end
	local sec = se:section_name()
	if string.find(sec, "space_restrictor", 1, true) then return false end
	if get_object_story_id(se.id) ~= nil and not p.names[se:name()] then return false end
	local nm = se:name()
	if p.names[nm] then return true end
	if p.ids ~= nil and p.ids[se.id] == nm then return true end
	if p.hiding and string.find(nm, "_hiding_", 1, true) then return true end
	if not p.items or keep_section(sec) then return false end
	if IsStalker(se) or IsMonster(se) then return false end
	return system_ini():line_exist(sec, "inv_name")
end

function done(lvl)
	local p = PURGE[lvl or level.name()]
	return p == nil or diary_lib.has(p.flag)
end

function level_enter(lvl)
	cur = 1
	cur_level = lvl
end

function level_leave()
	cur_level = nil
end

function update()
	local p = PURGE[cur_level]
	if p == nil or diary_lib.has(p.flag) then return end
	local sim = alife()
	local lid = sim:level_id()
	local aid = db.actor:id()
	local last = math.min(cur + PORTION, 65535)
	for i = cur, last do
		local se = sim:object(i)
		if se ~= nil and i ~= aid then
			local ok, rel = pcall(should_release, p, se, lid)
			if ok and rel then sim:release(se, true) end
		end
	end
	cur = last + 1
	if cur > 65535 then
		diary_lib.give(p.flag)
	end
end
