--------------------------------------------------------------------------------
--' Дневник проводника: мир.
--'  - Лоцман на Скадовске; Крим, торговцы, техники и медики на Лесничестве и в Цехах подстанции;
--'  - наёмники нейтральны только у себя в Цехах; "поводок" точек (мутанты и сталкеры не уходят далеко);
--'  - лаборатория под Железным лесом открыта;
--'  - после конца линий Султана и Крима их базы со временем пустеют (правка 25);
--'  - дубли сюжетных NPC из старых сейвов убираются (правка 8, см. story_objects.script);
--'  - на Янове возвращаются Азот, Сенька и учёные (правка 28).
--' Каждая часть со своим интервалом; всё, что относится только к Затону, на других уровнях не работает.
--------------------------------------------------------------------------------
local has, give = diary_lib.has, diary_lib.give

RADIUS = 75                                  --' радиус точки (диаметр 150 м); использует и sim_board
local MERC_HOME = "zat_b103_merc_smart"      --' Цеха подстанции: только здесь наёмники нейтральны
local GUIDE_SQUAD = "zat_b215_stalker_guide_zaton_squad"
local LEASH_SLACK = 15

--' Крим, торговцы, техники и медики: секция спавна = story id (story_id прописан в spawn_sections_zaton.ltx),
--' точка из points_named_zaton.txt {x, y, z, lv, gv}; base - чья это база (для опустения)
local SERVICE = {
	{sec = "diary_krim",        pos = {-149.22, 23.72, -421.50, 643967, 4},    base = "kri", boss = true},
	{sec = "diary_trader_b5",   pos = {412.64, 36.26, 4.93, 1642596, 293},     base = "sul"},
	{sec = "diary_tech_b5",     pos = {415.97, 36.26, -11.87, 1647668, 293},   base = "sul"},
	{sec = "diary_medic_b5",    pos = {412.50, 39.49, -19.25, 1642568, 293},   base = "sul"},
	{sec = "diary_trader_b103", pos = {-148.41, 23.59, -428.08, 645406, 4},    base = "kri"},
	{sec = "diary_tech_b103",   pos = {-142.46, 24.12, -413.34, 658255, 4},    base = "kri"},
	{sec = "diary_medic_b103",  pos = {-133.77, 24.57, -399.65, 674213, 4},    base = "kri"},
}
--' стоят строго на своих точках
local PINNED = {
	{sid = "zat_b7_bandit_boss_sultan", pos = {405.50, 39.45, -11.98}, until_info = "diary_perezd_done"},
}
for _, s in ipairs(SERVICE) do table.insert(PINNED, {sid = s.sec, pos = s.pos}) end
local PIN_DIST = 0.7

--' ---- Лоцман ---------------------------------------------------------------------------------------------
local function guide_tick()
	if has("diary_guide_spawned") then return end
	if get_story_object_id(GUIDE_SQUAD) == nil then
		local sb = sim_board.get_sim_board()
		local sm = sb.smarts_by_names["zat_stalker_base_smart"]
		if sm == nil then return end
		local sq = sb:create_squad(sm, GUIDE_SQUAD)
		sb:enter_smart(sq, sm.id)
	end
	give("diary_guide_spawned")
end

--' ---- Сервисные NPC: создать недостающих, сдвинутых вернуть на точку (раз за загрузку) -----------------------
local service_checked = false

local function base_empty(base)
	return has("diary_base_empty_" .. base)
end

local function service_tick()
	if service_checked then return end
	service_checked = true
	for _, s in ipairs(SERVICE) do
		local p = s.pos
		local pos = vector():set(p[1], p[2], p[3])
		local id = get_story_object_id(s.sec)
		local se = id and alife():object(id)
		if se == nil and not base_empty(s.base) and not has("diary_gone_" .. s.sec) then
			--' story_id в секции: после загрузки объект найдётся сам, второго не будет
			alife():create(s.sec, pos, p[4], p[5])
			give("diary_service_v2_" .. s.sec)
			if s.sec == "diary_krim" then give("diary_krim_spawned") end
		elseif se ~= nil and level.object_by_id(se.id) == nil and se.position:distance_to(pos) > 3 then
			diary_lib.place_npc(se.id, pos, p[4])
		end
	end
	give("diary_service_spawned")
end

--' старые сейвы: у созданных раньше NPC внутри старая логика (custom_data сохраняется в объекте),
--' например, у техников выключена кнопка улучшений. Пересоздаём каждого один раз, когда он оффлайн.
local function service_upgrade_tick()
	for _, s in ipairs(SERVICE) do
		local flag = "diary_service_v2_" .. s.sec
		if s.sec ~= "diary_krim" and not has(flag) then
			local id = get_story_object_id(s.sec)
			local pending = diary_lib.load_var(flag, false)
			if id == nil and pending then
				--' старый удалён - ставим нового (на следующем тике, чтобы story_id успел освободиться)
				local p = s.pos
				alife():create(s.sec, vector():set(p[1], p[2], p[3]), p[4], p[5])
				diary_lib.save_var(flag, nil)
				give(flag)
			elseif id == nil then
				give(flag)
			elseif not pending and level.object_by_id(id) == nil then
				diary_lib.release(id)
				diary_lib.save_var(flag, true)
			end
		end
	end
end

--' в онлайне: кто сдвинулся с точки (не в разговоре) - обратно на точку
local function pin_tick()
	for _, v in ipairs(PINNED) do
		if v.until_info == nil or not has(v.until_info) then
			local id = get_story_object_id(v.sid)
			local o = id and level.object_by_id(id)
			if o ~= nil and o:alive() and not o:is_talking() then
				local pos = vector():set(v.pos[1], v.pos[2], v.pos[3])
				if o:position():distance_to(pos) > PIN_DIST then o:set_npc_position(pos) end
			end
		end
	end
end

--' нейтральны к игроку независимо от группировки
local neutral_done = {}
local function neutral_tick()
	local a = db.actor
	for _, s in ipairs(SERVICE) do
		local id = get_story_object_id(s.sec)
		local obj = id and level.object_by_id(id)
		if obj ~= nil and neutral_done[id] == nil and obj:alive() then
			game_relations.set_npcs_relation(obj, a, "neutral")
			neutral_done[id] = true
		end
	end
end

--' ---- Наёмники: нейтральны только в Цехах подстанции ---------------------------------------------------------
local smart_level = {}
local function same_level(obj, lid)
	local l = smart_level[obj.id]
	if l == nil then
		l = game_graph():vertex(obj.m_game_vertex_id):level_id()
		smart_level[obj.id] = l
	end
	return l == lid
end

--' отряды заданий сами решают, как относятся к игроку
local function job_squad(sq)
	local sec = sq:section_name()
	return string.sub(sec, 1, 3) == "dj_"
end

local merc_state = {}
local CAMP_SQUAD = "diary_merc_camp"      --' единственный отряд лагеря: 4 наёмника + Крим, торговец, техник и медик = 8

--' Лагерь в Цехах дружелюбен: все наёмники внутри точки нейтральны. Вне Цехов и без "поводка" наёмники
--' живут по обычным правилам игры. Если игрок вступил в бой с должником Компаса, не мешаем.
local function merc_relation_tick()
	if has("diary_deb_3_fight") and not has("diary_deb_3_done") then return end
	local sb = sim_board.get_sim_board()
	local home = sb.smarts_by_names[MERC_HOME]
	if home == nil then return end
	local smart = sb.smarts[home.id]
	if smart == nil then return end
	for _, sq in pairs(smart.squads) do
		if sq.player_id == "killer" and not job_squad(sq) and merc_state[sq.id] ~= "neutral" then
			merc_state[sq.id] = "neutral"
			sq.relationship = "neutral"
			sq:set_squad_relation("neutral")
		end
	end
end

--' Создать отряд лагеря и один раз убрать лишних наёмников, которых раньше присылала симуляция
local function camp_tick()
	if has("diary_mercs_gone") then return end
	local sb = sim_board.get_sim_board()
	local sm = sb.smarts_by_names[MERC_HOME]
	if sm == nil then return end
	if not has("diary_camp_v1") and get_story_object_id(CAMP_SQUAD) == nil then
		local sq = sb:create_squad(sm, CAMP_SQUAD)
		sb:enter_smart(sq, sm.id)
	end
	if get_story_object_id(CAMP_SQUAD) ~= nil then give("diary_camp_v1") end
	if not has("diary_camp_v1") or has("diary_camp_clean_v1") then return end
	local smart = sb.smarts[sm.id]
	if smart == nil then return end
	local debtor = diary_lib.load_var("diary_deb_id3", -1)
	local drop, left = {}, 0
	for _, sq in pairs(smart.squads) do
		if sq.player_id == "killer" and not job_squad(sq) and sq:section_name() ~= CAMP_SQUAD then
			local keep = false
			for m in sq:squad_members() do
				if level.object_by_id(m.id) ~= nil or m.id == debtor then keep = true end
			end
			if keep then left = left + 1 else table.insert(drop, sq) end
		end
	end
	for _, sq in ipairs(drop) do sb:remove_squad(sq) end
	if left == 0 then give("diary_camp_clean_v1") end
end

--' ---- Поводок -----------------------------------------------------------------------------------------------
--' Симуляция: отряд с точкой не выбирает других целей (sim_board.get_squad_target).
--' Сталкеры: враг дальше RADIUS + LEASH_SLACK от центра точки не считается врагом (xr_combat_ignore.is_enemy).
--' Мутанты: дом в центре точки с радиусом RADIUS.
local function squad_smart(se_obj)
	if se_obj == nil or se_obj.group_id == nil or se_obj.group_id == 65535 then return nil end
	local sq = alife():object(se_obj.group_id)
	if sq == nil or sq.smart_id == nil then return nil end
	if sq.current_action ~= nil and sq.current_action.name == "reach_target" then return nil end
	return alife():object(sq.smart_id)
end

local function leash_check(obj, enemy)
	--' аномальное затишье: мутанты и люди не держатся своих точек
	if diary_zone.calm_active() then return false end
	local smart = squad_smart(alife():object(obj:id()))
	return smart ~= nil and enemy:position():distance_to(smart.position) > RADIUS + LEASH_SLACK
end

function out_of_leash(obj, enemy)
	local ok, r = pcall(leash_check, obj, enemy)
	return ok and r == true
end

local home_set = {}
local function leash_monster(obj, smart)
	if home_set[obj:id()] ~= smart.id or obj:position():distance_to(smart.position) > RADIUS * 0.7 then
		obj:set_home(smart.m_level_vertex_id, RADIUS * 0.3, RADIUS, true, RADIUS * 0.6)
		home_set[obj:id()] = smart.id
	end
end

local function leash_tick()
	if diary_zone.calm_active() then
		--' затишье: мутанты срываются с точек
		for id in pairs(home_set) do
			local obj = level.object_by_id(id)
			if obj ~= nil and obj:alive() then pcall(function() obj:remove_home() end) end
		end
		home_set = {}
		return
	end
	local sb = sim_board.get_sim_board()
	local lid = alife():level_id()
	local ap = db.actor:position()
	for _, s in pairs(sb.smarts) do
		local smart = s.smrt
		if same_level(smart, lid) and smart.position:distance_to(ap) < 350 then
			for _, sq in pairs(s.squads) do
				local moving = sq.current_action ~= nil and sq.current_action.name == "reach_target"
				if not moving then
					for k in sq:squad_members() do
						local obj = level.object_by_id(k.id)
						if obj ~= nil and obj:alive() and IsMonster(obj) then pcall(leash_monster, obj, smart) end
					end
				end
			end
		end
	end
end

--' ---- Лаборатория под Железным лесом: замок снят, дверь открывается клавишей использования -----------------
local function lab_tick()
	if has("diary_lab_unlocked") then return end
	local id = get_story_object_id("zat_a23_enter_door_lock")
	diary_lib.release(id)
	give("diary_lab_unlocked")
end

--' ---- Базы пустеют после конца линий (правка 25) ---------------------------------------------------------------
--' Когда обе линии (Султана и Крима) закрыты, через delay часов, пока игрок далеко (оффлайн),
--' с Лесничества и из Цехов уходят все. Главарь уходит, только когда закрыт долг Компаса перед ним (правка 26).
local BOSS_DEBT = {sul = "diary_deb_1_done", kri = "diary_deb_2_done"}

local function lines_closed()
	return diary_jobs.state("s9", "done") and diary_jobs.state("k7", "done")
end

local function empty_smart(name)
	local sm = diary_lib.smart(name)
	if sm == nil then return true end
	if db.actor:position():distance_to(sm.position) < 200 then return false end
	local sb = sim_board.get_sim_board()
	local list = {}
	for id, sq in pairs(sb.smarts[sm.id] and sb.smarts[sm.id].squads or {}) do table.insert(list, sq) end
	for _, sq in ipairs(list) do
		local keep = false
		for m in sq:squad_members() do
			if level.object_by_id(m.id) ~= nil then keep = true end
			--' Султан остаётся, пока не закрыт долг Компаса перед ним
			if get_object_story_id(m.id) == "zat_b7_bandit_boss_sultan" and not has(BOSS_DEBT.sul) then keep = true end
		end
		if not keep then sb:remove_squad(sq) end
	end
	return true
end

local function base_tick()
	if not lines_closed() then return end
	if not diary_lib.timer_set("diary_base_empty_t") then
		diary_lib.start_timer("diary_base_empty_t", diary_cfg.num("base_empty", "delay", 48))
		return
	end
	if not diary_lib.timer_done("diary_base_empty_t") then return end
	for _, name in ipairs(diary_cfg.list("base_empty", "smarts")) do empty_smart(name) end
	for _, s in ipairs(SERVICE) do
		local can_go = not s.boss or has(BOSS_DEBT[s.base])
		local id = get_story_object_id(s.sec)
		if can_go and id ~= nil and level.object_by_id(id) == nil then
			diary_lib.release(id)
			give("diary_gone_" .. s.sec)
		end
	end
	give("diary_base_empty_sul")
	give("diary_base_empty_kri")
end

--' Наёмники Цехов подстанции не уходят, пока здесь Крим. Через merc_delay часов после его ухода уходят
--' и они (если Крим ушёл раньше, отсчёт начинается с первой проверки).
local function merc_tick()
	if not has("diary_gone_diary_krim") then return end
	if not diary_lib.timer_set("diary_merc_leave_t") then
		diary_lib.start_timer("diary_merc_leave_t", diary_cfg.num("base_empty", "merc_delay", 48))
		return
	end
	if not diary_lib.timer_done("diary_merc_leave_t") or has("diary_mercs_gone") then return end
	if empty_smart(diary_cfg.str("base_empty", "merc_smart", "zat_b103_merc_smart")) then give("diary_mercs_gone") end
end

--' ---- Юпитер: вернуть на место Азота, Сеньку и учёных (правка 28) -----------------------------------------
--' Отряд создаётся, если его нет и его главного NPC тоже нет (работает и в старых сейвах).
local JUP_RESTORE = {
	{squad = "diary_jup_azot_squad",        npc = "jup_b217_stalker_tech",           smart = "jup_a6"},
	{squad = "jup_b10_stalker_drunk_squad", npc = "jup_b10_stalker_drunk",           smart = "jup_a6"},
	{squad = "jup_b6_scientist_group",      npc = "jup_b6_scientist_nuclear_physicist", smart = "jup_b41"},
}

local function jupiter_tick()
	local sb = sim_board.get_sim_board()
	for _, r in ipairs(JUP_RESTORE) do
		local flag = "diary_jup_restored_" .. r.squad
		if not has(flag) then
			if get_story_object_id(r.squad) == nil and get_story_object_id(r.npc) == nil then
				local sm = sb.smarts_by_names[r.smart]
				if sm ~= nil then
					local sq = sb:create_squad(sm, r.squad)
					sb:enter_smart(sq, sm.id)
				end
			end
			give(flag)
		end
	end
end

--' ---- Дубли сюжетных NPC из старых сейвов --------------------------------------------------------------------
local function duplicates_tick()
	local d = story_objects.duplicates
	if d == nil or #d == 0 then return end
	for i = #d, 1, -1 do
		local id = d[i]
		if level.object_by_id(id) == nil then
			diary_lib.release(id)
			table.remove(d, i)
		end
	end
end

--' ---- Модуль ----------------------------------------------------------------------------------------------------
local TICKS = {
	{fn = duplicates_tick, dt = 1000},
	{fn = guide_tick,      dt = 5000, zaton = true},
	{fn = service_tick,    dt = 5000, zaton = true},
	{fn = service_upgrade_tick, dt = 5000, zaton = true},
	{fn = function() diary_disguise.safety() end, dt = 5000},
	{fn = neutral_tick,    dt = 2000, zaton = true},
	{fn = merc_relation_tick, dt = 3000, zaton = true},
	{fn = camp_tick,       dt = 7000, zaton = true},
	{fn = pin_tick,        dt = 500,  zaton = true},
	{fn = lab_tick,        dt = 5000, zaton = true},
	{fn = function() diary_pda.unlock_tick() end, dt = 2000, zaton = true},
	{fn = base_tick,       dt = 10000, zaton = true},
	{fn = merc_tick,       dt = 10000, zaton = true},
	{fn = leash_tick,      dt = 1000},
	{fn = jupiter_tick,    dt = 5000, jupiter = true},
}
local next_t = {}

function level_enter(lvl)
	next_t = {}
	service_checked = false
	neutral_done = {}
	home_set = {}
	merc_state = {}
end

function level_leave()
	smart_level = {}
	home_set = {}
	neutral_done = {}
	merc_state = {}
end

function update()
	local t = time_global()
	local lvl = level.name()
	local on_zaton = lvl == "zaton"
	for i, k in ipairs(TICKS) do
		if t >= (next_t[i] or 0) and (not k.zaton or on_zaton) and (not k.jupiter or lvl == "jupiter") then
			next_t[i] = t + k.dt
			diary_main.safe("world." .. i, k.fn)
		end
	end
end
