--------------------------------------------------------------------------------
--' Дневник проводника: лесопилка (Затон).
--' Внутри барьера идти можно только по тропе (дороги и зоны) и только с артефактом "Компас",
--' иначе через throw_delay секунд выбрасывает в случайную точку уровня.
--' Перед барьером - автосохранение. После трёх записей выход за барьер роняет труп.
--' Геометрия грузится при входе на Затон и освобождается при уходе.
--------------------------------------------------------------------------------
local geo = nil         --' таблицы геометрии, только на Затоне

local function load_geometry()
	return {
		--' барьер лесопилки (x, z), обход по контуру
		perimeter = {
			{-312.93, 309.01}, {-291.51, 323.83}, {-285.50, 330.69}, {-281.05, 410.85},
			{-297.09, 447.81}, {-397.29, 411.84}, {-391.69, 311.46},
		},
		--' дороги (ломаные): ЛПЧ, ЛПБ, ЛПБ2, ЛПББ, ЛПБВ
		roads = {
			{{-285.81, 398.73}, {-293.01, 397.97}, {-303.19, 398.26}, {-308.95, 406.64}},
			{{-309.98, 394.04}, {-361.35, 386.26}},
			{{-304.36, 386.93}, {-309.37, 361.37}},
			{{-360.22, 356.92}, {-363.46, 381.66}},
			{{-329.28, 336.95}, {-327.47, 318.41}, {-326.16, 298.40}},
		},
		--' зоны тайников: ТЧК1 (чердак), ТЧК2 (башня), ТЧК3 (брёвна)
		zones = {
			{{-307.37, 401.89}, {-306.60, 430.26}, {-322.61, 430.02}, {-322.57, 421.66}, {-334.97, 421.45}, {-335.18, 410.80}, {-321.72, 410.63}, {-323.36, 401.91}},
			{{-359.58, 392.25}, {-375.47, 392.56}, {-375.95, 373.36}, {-360.94, 373.40}},
			{{-291.68, 362.75}, {-334.89, 362.32}, {-369.29, 359.41}, {-370.90, 337.90}, {-357.34, 329.63}, {-292.70, 332.28}},
		},
		--' куда выбрасывает
		throw = {
			{258.2, 19.6, 548.2}, {-269.8, 40.0, -505.4}, {607.2, 15.3, -320.3},
			{-517.0, 23.6, 438.4}, {25.3, -5.4, 19.4}, {479.1, 32.8, 125.8},
			{-552.1, 10.1, -11.1}, {143.0, 27.8, -391.1}, {-65.4, -4.4, 671.5},
			{-119.5, 4.7, 317.4},
		},
	}
end

--' ---- Геометрия ----------------------------------------------------------------
local function in_polygon(poly, x, z)
	local inside = false
	local j = #poly
	for i = 1, #poly do
		local xi, zi = poly[i][1], poly[i][2]
		local xj, zj = poly[j][1], poly[j][2]
		if ((zi > z) ~= (zj > z)) and (x < (xj - xi) * (z - zi) / (zj - zi) + xi) then
			inside = not inside
		end
		j = i
	end
	return inside
end

local function dist_seg(px, pz, ax, az, bx, bz)
	local dx, dz = bx - ax, bz - az
	local l2 = dx * dx + dz * dz
	local t = 0
	if l2 > 0 then
		t = ((px - ax) * dx + (pz - az) * dz) / l2
		if t < 0 then t = 0 elseif t > 1 then t = 1 end
	end
	local cx, cz = ax + t * dx, az + t * dz
	return math.sqrt((px - cx) * (px - cx) + (pz - cz) * (pz - cz))
end

local function on_path(x, z)
	for _, zone in ipairs(geo.zones) do
		if in_polygon(zone, x, z) then return true end
	end
	local half = diary_cfg.num("sawmill", "road_half", 5)
	for _, r in ipairs(geo.roads) do
		for k = 1, #r - 1 do
			if dist_seg(x, z, r[k][1], r[k][2], r[k + 1][1], r[k + 1][2]) <= half then return true end
		end
	end
	return false
end

local function dist_perimeter(x, z)
	local best = 1e9
	local p = geo.perimeter
	local j = #p
	for i = 1, #p do
		local d = dist_seg(x, z, p[j][1], p[j][2], p[i][1], p[i][2])
		if d < best then best = d end
		j = i
	end
	return best
end

--' Внутри барьера (для других модулей)
function actor_inside()
	if geo == nil then return false end
	local p = db.actor:position()
	return in_polygon(geo.perimeter, p.x, p.z)
end

--' ---- Труп за барьером ------------------------------------------------------------
local corpse = nil      --' {id, until_t, next_t, fx, snd, fx_stop}

local function drop_corpse()
	local a = db.actor
	local d = device().cam_dir
	local len = math.sqrt(d.x * d.x + d.z * d.z)
	local dx, dz = 0, 1
	if len > 0.01 then dx, dz = d.x / len, d.z / len end
	local p = a:position()
	local pos = vector():set(p.x + dx * 6.0, p.y + 4.5, p.z + dz * 6.0)
	local se = alife():create("sim_default_stalker_1", pos, a:level_vertex_id(), a:game_vertex_id())
	se.death_droped = true
	se:kill()
	local t = time_global()
	corpse = {id = se.id, until_t = t + diary_cfg.num("story", "corpse_lifetime", 8) * 1000, next_t = 0, fx_stop = t + 1200}
	pcall(function()
		corpse.fx = particles_object("anomaly2\\teleport_out_00")
		corpse.fx:play_at_pos(pos)
		corpse.snd = sound_object("anomaly\\teleport_incoming")
		corpse.snd:play_at_pos(a, pos, 0, sound_object.s3d)
	end)
	diary_lib.give("diary_corpse_dropped")
	diary_news.thought("diary_news_corpse_t")
	diary_news.record("corpse")
end

--' портал короткий; труп должен быть пустым
local function corpse_update()
	if corpse == nil then return end
	local t = time_global()
	if corpse.fx_stop ~= nil and t >= corpse.fx_stop then
		corpse.fx_stop = nil
		pcall(function() corpse.fx:stop() end)
		pcall(function() corpse.snd:stop() end)
	end
	if t > corpse.until_t then
		corpse = nil
		return
	end
	if t < corpse.next_t then return end
	corpse.next_t = t + 300
	local obj = level.object_by_id(corpse.id)
	if obj == nil then return end
	local ids = {}
	obj:iterate_inventory(function(owner, item) table.insert(ids, item:id()) end, obj)
	for _, id in ipairs(ids) do diary_lib.release(id) end
end

--' ---- Модуль ------------------------------------------------------------------------
local st = nil          --' состояние на уровне: zone_t, warned, save_armed, was_inside

function level_enter(lvl)
	geo = load_geometry()
	st = {zone_t = nil, warned = false, save_armed = true, was_inside = false}
end

function level_leave()
	geo = nil
	st = nil
	corpse = nil
end

local function notes_done()
	return diary_lib.has("diary_q3_done") and diary_lib.has("diary_q4_done") and diary_lib.has("diary_q5_done")
end

function update()
	local a = db.actor
	corpse_update()
	if not diary_lib.has("diary_q1_given") then return end
	local t = time_global()
	local p = a:position()
	local inside = in_polygon(geo.perimeter, p.x, p.z)

	if inside and diary_lib.has("diary_chain_spawned") then
		diary_lib.give("diary_saw_reached")
	end

	if inside then
		--' без компаса или вне тропы - выбрасывает
		if a:object("af_compass") ~= nil and on_path(p.x, p.z) then
			st.zone_t = nil
			st.warned = false
		elseif st.zone_t == nil then
			st.zone_t = t
			if not st.warned then
				st.warned = true
				diary_news.thought("diary_news_warn_t")
			end
		elseif t - st.zone_t >= diary_cfg.num("sawmill", "throw_delay", 5) * 1000 then
			st.zone_t = nil
			st.warned = false
			st.was_inside = false
			local d = geo.throw[math.random(#geo.throw)]
			diary_lib.teleport_actor(vector():set(d[1], d[2], d[3]))
			diary_news.thought("diary_news_tele_t")
			diary_news.record("throw")
			return
		end
	else
		st.zone_t = nil
		st.warned = false
		--' автосохранение на подходе к барьеру (Правила: сейв перед ключевой точкой)
		if diary_lib.has("diary_notebook_given") and not diary_lib.has("diary_saw_saved") then
			local dp = dist_perimeter(p.x, p.z)
			if st.save_armed and dp < diary_cfg.num("sawmill", "save_near", 40) then
				st.save_armed = false
				diary_lib.give("diary_saw_saved")
				pcall(xr_effects.scenario_autosave, a, nil, {"st_save_diary_sawmill"})
			elseif dp > diary_cfg.num("sawmill", "save_rearm", 120) then
				st.save_armed = true
			end
		end
	end

	--' три записи найдены: выход за барьер роняет труп
	if notes_done() and not diary_lib.has("diary_corpse_dropped") then
		if inside then
			st.was_inside = true
		elseif st.was_inside then
			st.was_inside = false
			drop_corpse()
		end
	end
end
