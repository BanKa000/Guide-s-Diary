--------------------------------------------------------------------------------
--' Дневник проводника: блокнот Компаса.
--' Записки вносятся в блокнот (предмет-записка изымается), зашифрованная записка остаётся предметом.
--' Первая страница после получения долгового листа: вырванный листок на блокноте.
--' Открывается через "Использовать" в инвентаре (предмет возвращается) или по F4 в паузе.
--------------------------------------------------------------------------------
local NOTEBOOK = {key = "notebook", sec = "jup_a9_power_info", info = "diary_read_notebook"}
local NOTES = {
	{key = "cave",  sec = "jup_b10_notes_01"},
	{key = "logs",  sec = "jup_b10_notes_02"},
	{key = "attic", sec = "jup_a9_meeting_info"},
	{key = "tower", sec = "jup_a9_delivery_info", keep = true},   --' зашифрована: не читается, остаётся в инвентаре
}

local function noted(key)
	local a = db.actor
	return a ~= nil and a:has_info("diary_noted_" .. key)
end

class "doc_reader" (CUIScriptWnd)

function doc_reader:__init() super()
	self:SetWndRect(Frect():set(0,0,1024,768))
	self:Enable(true)
	local xml = CScriptXmlInit()
	xml:ParseFile("diary_reader.xml")
	xml:InitStatic("rd_bg_nb", self)
	local function mk(name, complex)
		local s = xml:InitStatic(name, self)
		if complex then pcall(function() s:SetTextComplexMode(true) end) end
		return s
	end
	local a = db.actor
	self.all = {}
	local function reg(...)
		local t = {...}
		for i = 1, #t do table.insert(self.all, t[i]) end
		return t
	end
	--' страница "intro"
	local intro = reg(mk("rd_body_notebook", true), mk("rd_body_notebook2", true))
	--' разворот 2: карта | брёвна
	local map = mk("nb_map")
	local bl1, bl2, bl3, bl4 = mk("nb_blank_1"), mk("nb_blank_2"), mk("nb_blank_3"), mk("nb_blank_4")
	local tl, bl = mk("nb_t_logs"), mk("nb_b_logs", true)
	local ta, ba = mk("nb_t_attic"), mk("nb_b_attic", true)
	local cph = mk("nb_cipher", true)
	if a ~= nil and a:has_info("diary_debts_given") then
		pcall(function() cph:TextControl():SetText(game.translate_string("diary_nb_cipher_done")) end)
	end
	reg(map, bl1, bl2, bl3, bl4, tl, bl, ta, ba, cph)
	local p2, p3 = {}, {}
	if noted("cave") then table.insert(p2, map) else table.insert(p2, bl1) end
	if noted("logs") then table.insert(p2, tl) table.insert(p2, bl) else table.insert(p2, bl2) end
	if noted("attic") then table.insert(p3, ta) table.insert(p3, ba) else table.insert(p3, bl3) end
	if noted("tower") then table.insert(p3, cph) else table.insert(p3, bl4) end
	--' листок с долгами поверх блокнота (создаётся последним, чтобы лежать сверху)
	local sheet = mk("nb_dt_sheet")
	local dtt = mk("nb_dt_title")
	self.dt_body = mk("nb_dt_body", true)
	reg(sheet, dtt, self.dt_body)
	local debts = {unpack(intro)}
	table.insert(debts, sheet) table.insert(debts, dtt) table.insert(debts, self.dt_body)
	--' второй лист: должники Компаса (тоже поверх блокнота)
	local dsheet = mk("nb_dl_sheet")
	local dtitle = mk("nb_dl_title")
	self.dl_body = mk("nb_dl_body", true)
	reg(dsheet, dtitle, self.dl_body)
	local deb = {unpack(intro)}
	table.insert(deb, dsheet) table.insert(deb, dtitle) table.insert(deb, self.dl_body)
	self.has_deb = a ~= nil and a:has_info("diary_deb_ready")
	self.order = {}
	if a ~= nil and a:has_info("diary_debts_given") then table.insert(self.order, debts) end
	if self.has_deb then table.insert(self.order, deb) end
	self.deb_page = deb
	table.insert(self.order, intro)
	table.insert(self.order, p2)
	table.insert(self.order, p3)
	self.has_debts = a ~= nil and a:has_info("diary_debts_given")
	self.pg = xml:InitStatic("nb_pg", self)
	local bp = xml:Init3tButton("nb_btn_prev", self)
	local bc = xml:Init3tButton("nb_btn_close", self)
	local bn = xml:Init3tButton("nb_btn_next", self)
	self:Register(bp, "nb_btn_prev")
	self:Register(bc, "nb_btn_close")
	self:Register(bn, "nb_btn_next")
	self:AddCallback("nb_btn_prev", ui_events.BUTTON_CLICKED, function() self:flip(-1) end, self)
	self:AddCallback("nb_btn_next", ui_events.BUTTON_CLICKED, function() self:flip(1) end, self)
	self:AddCallback("nb_btn_close", ui_events.BUTTON_CLICKED, function() self:HideDialog() end, self)
	self.page = 1
	self:show_page()
end

function doc_reader:show_page()
	for i = 1, #self.all do self.all[i]:Show(false) end
	local grp = self.order[self.page]
	for i = 1, #grp do grp[i]:Show(true) end
	if self.has_debts and self.page == 1 then
		pcall(function()
			self.dt_body:TextControl():SetText(diary_debts.sheet_text("c") .. "\n" .. diary_debts.sheet_text("s"))
		end)
	end
	--' сравнивать страницы (таблицы Lua), не окна: == для объектов движка даёт "No such operator defined"
	if self.has_deb and grp == self.deb_page then
		pcall(function() self.dl_body:TextControl():SetText(diary_debts.deb_sheet_text()) end)
	end
	pcall(function() self.pg:TextControl():SetText(self.page .. " / " .. #self.order) end)
end

function doc_reader:flip(d)
	local n = #self.order
	local p = self.page + d
	if p < 1 then p = n elseif p > n then p = 1 end
	self.page = p
	self:show_page()
end

function doc_reader:OnKeyboard(dik, keyboard_action)
	local res = CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
	if res == false then
		if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
			if dik == DIK_keys.DIK_ESCAPE then
				self:HideDialog()
			elseif dik == DIK_keys.DIK_LEFT then
				self:flip(-1)
			elseif dik == DIK_keys.DIK_RIGHT then
				self:flip(1)
			end
		end
	end
	return res
end

local open_wanted = false
local ui_cur = nil
local regiven = false
local cipher_regiven = false

local function busy()
	local ok, rcv = pcall(function() return level.main_input_receiver() end)
	if ok then return rcv ~= nil end
	return false
end

function request_menu()
	open_wanted = true
end

local function news(txt)
	db.actor:give_game_news("", game.translate_string(txt), "ui_iconsTotal_storyline", 0, 6000)
end

function level_leave()
	ui_cur = nil
	open_wanted = false
end

--' раз в 300 мс (diary_main)
function update()
	local a = db.actor
	do
		--' записки в инвентаре -> вносятся в блокнот (зашифрованная остаётся в инвентаре)
		for i = 1, #NOTES do
			local n = NOTES[i]
			local o = a:object(n.sec)
			if o ~= nil then
				local first = not a:has_info("diary_noted_" .. n.key)
				if first then a:give_info_portion("diary_noted_" .. n.key) end
				if not n.keep then
					local se = alife():object(o:id())
					if se ~= nil then alife():release(se, true) end
					if first and a:object(NOTEBOOK.sec) ~= nil then news("diary_news_noted") end
				end
			end
		end
		--' зашифрованная записка: "Использовать" не должно её уничтожать -> возвращаем и сообщаем, что не прочесть
		if a:has_info("diary_noted_tower") and not a:has_info("diary_cipher_taken") then
			local hc = a:object(NOTES[4].sec) ~= nil
			if (not hc) and not cipher_regiven then
				cipher_regiven = true
				pcall(function()
					alife():create(NOTES[4].sec, a:position(), a:level_vertex_id(), a:game_vertex_id(), a:id())
					news("diary_news_cipher")
				end)
			elseif hc then
				cipher_regiven = false
			end
		end
		--' блокнот: использование (предмет расходуется) -> возвращаем и открываем
		local have = a:object(NOTEBOOK.sec) ~= nil
		if have and not a:has_info(NOTEBOOK.info) then
			a:give_info_portion(NOTEBOOK.info)
		elseif (not have) and a:has_info(NOTEBOOK.info) and not regiven then
			regiven = true
			pcall(function()
				alife():create(NOTEBOOK.sec, a:position(), a:level_vertex_id(), a:game_vertex_id(), a:id())
			end)
			open_wanted = true
		elseif have then
			regiven = false
		end
	end
	if busy() then return end
	if open_wanted then
		open_wanted = false
		if a:has_info(NOTEBOOK.info) then
			ui_cur = doc_reader()
			ui_cur:ShowDialog(true)
		end
	end
end
