--------------------------------------------------------------------------------
--' Дневник проводника: задания линий (Борода, Султан, Крим, Сыч, Тремор, Гаваец).
--' Описание заданий - configs\misc\diary_jobs.ltx, тексты - st_diary_jobs.xml,
--' диалоги - dialogs_zaton.xml (собирает tools\diary_build.py), функции диалогов - dialogs_diary.script.
--' Особые задания (scene и доработки) - diary_jobs_zat.script, этот модуль их только вызывает.
--'
--' Состояние задания <id>: инфопорции dj_<id>_given / dj_<id>_obj (цель выполнена) / dj_<id>_done;
--' остальное - pstor "dj_<id>_*" (метки, отряды, предметы).
--------------------------------------------------------------------------------
local has, give = diary_lib.has, diary_lib.give

local GIVER = {
	bor = "zat_a2_stalker_barmen", car = "zat_a2_stalker_mechanic", sul = "zat_b7_bandit_boss_sultan", kri = "diary_krim",
	syc = "zat_b30_owl_stalker_trader_id", tre = "zat_b22_stalker_medic", gav = "jup_a6_stalker_barmen",
}

Q = nil             --' id -> описание задания
ALLQ = nil          --' порядок заданий
local by_giver = nil

--' ---- Чтение diary_jobs.ltx --------------------------------------------------------------
local function split(s)
	local out = {}
	if s == nil then return out end
	for w in string.gmatch(s, "[^,]+") do
		w = string.gsub(w, "^%s+", "")
		w = string.gsub(w, "%s+$", "")
		if w ~= "" then table.insert(out, w) end
	end
	return out
end

--' "секция:кол-во, ..." -> {{секция, кол-во}, ...}
local function pairs_list(s)
	local out = {}
	for _, w in ipairs(split(s)) do
		local sec, n = string.match(w, "^([^:]+):(%d+)$")
		if sec == nil then sec, n = w, 1 end
		table.insert(out, {sec, tonumber(n)})
	end
	return out
end

--' "отряд@смарт, ..." -> {{отряд, смарт}, ...}
local function squads_list(s)
	local out = {}
	for _, w in ipairs(split(s)) do
		local sq, sm = string.match(w, "^([^@]+)@(.+)$")
		if sq ~= nil then table.insert(out, {sq, sm}) end
	end
	return out
end

local function load()
	if Q ~= nil then return end
	Q, ALLQ, by_giver = {}, {}, {}
	local ini = ini_file("misc\\diary_jobs.ltx")
	local function s(sec, line) return ini:line_exist(sec, line) and ini:r_string(sec, line) or nil end
	local n = ini:line_count("list")
	local last_of = {}
	for i = 0, n - 1 do
		local _, sec = ini:r_line("list", i, "", "")
		local id = string.gsub(sec, "^dj_", "")
		local q = {
			id = id, giver = s(sec, "giver"), kind = s(sec, "kind"), gate = s(sec, "gate"),
			level = s(sec, "level") or "zaton",
			money = tonumber(s(sec, "money") or "0") or 0,
			items = pairs_list(s(sec, "items")), reward = pairs_list(s(sec, "reward")),
			item = s(sec, "item"), smart = s(sec, "smart"), box = s(sec, "box"), point = s(sec, "point"), box_items = split(s(sec, "box_items")),
			spot = s(sec, "spot"),
			consume = s(sec, "consume") == "true",
			squads = squads_list(s(sec, "squads")), ambush = squads_list(s(sec, "ambush")),
			escort = squads_list(s(sec, "escort")),
			smarts = split(s(sec, "smarts")), talk_squad = s(sec, "talk_squad"), to = s(sec, "to"),
			captive = s(sec, "captive"), alt_pay = tonumber(s(sec, "alt_pay") or ""),
			on_done = split(s(sec, "on_done")),
		}
		local ch = s(sec, "choices")
		if ch ~= nil then
			q.choices = {}
			for _, m in ipairs(split(ch)) do table.insert(q.choices, tonumber(m) or 0) end
		end
		local prev = s(sec, "prev")
		if prev == "none" then
			q.prev = nil
		elseif prev ~= nil and prev ~= "" then
			q.prev = string.gsub(prev, "^dj_", "")
		else
			q.prev = last_of[q.giver]
		end
		last_of[q.giver] = id
		Q[id] = q
		table.insert(ALLQ, id)
		by_giver[q.giver] = by_giver[q.giver] or {}
		table.insert(by_giver[q.giver], id)
	end
end

function get(id)
	load()
	return Q[id]
end

function all()
	load()
	return ALLQ
end

--' ---- Хранилище задания -----------------------------------------------------------------
function var(id, name, def) return diary_lib.load_var("dj_" .. id .. "_" .. name, def) end
function set_var(id, name, v) diary_lib.save_var("dj_" .. id .. "_" .. name, v) end

function state(id, s) return has("dj_" .. id .. "_" .. s) end

--' выполнил ли игрок хоть одно задание этого заказчика (bor, syc, tre, sul, kri ...)
function giver_done(giver)
	load()
	for _, id in ipairs(by_giver[giver] or {}) do
		if state(id, "done") and not state(id, "cancelled") then return true end
	end
	return false
end
function set_state(id, s) give("dj_" .. id .. "_" .. s) end

local function hook(id, name)
	local h = diary_jobs_zat.HOOKS[id]
	return h and h[name]
end

--' ---- Метки на карте (сохраняются вместе с игрой) -------------------------------------------
function add_spot(id, obj_id, hint)
	local n = var(id, "n", 0) + 1
	set_var(id, "n", n)
	set_var(id, "s" .. n, obj_id)
	--' Меток на карте нет: цель показывает компас, а в блокноте - обводка карандашом (diary_pda).
	return n
end

function drop_spot(id, k)
	local sid = var(id, "s" .. k, 0)
	if sid ~= 0 then
		pcall(level.map_remove_object_spot, sid, "red_location")
		set_var(id, "s" .. k, 0)
	end
end

function clear_spots(id)
	for k = 1, var(id, "n", 0) do drop_spot(id, k) end
end

--' ---- Отряды задания ------------------------------------------------------------------------
function add_squad(id, squad_sec, smart_name, tag)
	local sq = diary_lib.create_squad(squad_sec, smart_name)
	if sq == nil then return nil end
	local n = var(id, "q", 0) + 1
	set_var(id, "q", n)
	set_var(id, "q" .. n, sq)
	if tag ~= nil then set_var(id, tag, sq) end
	return sq
end

function squads_alive(id)
	for k = 1, var(id, "q", 0) do
		if diary_lib.squad_alive(var(id, "q" .. k, 0)) > 0 then return true end
	end
	return false
end

function remove_squads(id)
	for k = 1, var(id, "q", 0) do diary_lib.remove_squad(var(id, "q" .. k, 0)) end
end

--' Невидимая точка для метки на карте (spot = точка из [job_points]); id объекта или nil
function spot_marker(name)
	local pos, lv, gv = diary_cfg.point("job_points", name)
	if pos == nil or lv == nil or gv == nil then return nil end
	return alife():create("diary_dj_marker", pos, lv, gv).id
end

--' ---- Предмет задания: в ящике или на земле ----------------------------------------------------
function spawn_item(q)
	local sm = q.smart and diary_lib.smart(q.smart)
	if sm == nil then
		diary_lib.give_items(q.item, 1)
		return nil
	end
	local pos, lv, gv
	if q.point ~= nil then pos, lv, gv = diary_cfg.point("job_points", q.point) end
	if q.box ~= nil then
		local box = diary_lib.create_at_smart(q.box, sm, pos, lv, gv)
		alife():create(q.item, vector():set(0, 0, 0), 0, 0, box.id)
		for _, it in ipairs(q.box_items) do alife():create(it, vector():set(0, 0, 0), 0, 0, box.id) end
		set_var(q.id, "box", box.id)
	else
		local se = diary_lib.create_at_smart(q.item, sm, pos, lv, gv)
		set_var(q.id, "item", se.id)
	end
	return sm
end

--' ---- Предложение, взятие, отчёт ---------------------------------------------------------------
TRUST_GAP = {syc = 5, tre = 5}

function line_index(id)
	local q = get(id)
	for k, v in ipairs(by_giver[q.giver]) do
		if v == id then return k end
	end
	return 1
end

function can_offer(id)
	local q = get(id)
	if q == nil or q.level ~= level.name() then return false end
	if state(id, "given") then return false end
	if q.gate ~= nil and not has(q.gate) then return false end
	if q.prev ~= nil and not state(q.prev, "done") then return false end
	--' "Бартер доверия": у Сыча и Тремора после первых двух просьб следующая - не раньше чем через 5 часов
	if TRUST_GAP[q.giver] ~= nil and q.prev ~= nil and line_index(id) > 2 then
		local t = var(q.prev, "done_t", nil)
		if t ~= nil and diary_lib.game_hours() - t < TRUST_GAP[q.giver] then return false end
	end
	local h = hook(id, "can_offer")
	if h ~= nil then return h(q) end
	return true
end

local function have_all_items(q)
	for _, p in ipairs(q.items) do
		if diary_lib.count_item(p[1]) < p[2] then return false end
	end
	return true
end

function can_report(id)
	local q = get(id)
	if q == nil or not state(id, "given") or state(id, "done") then return false end
	local h = hook(id, "can_report")
	if h ~= nil then return h(q) end
	if q.kind == "give" then return have_all_items(q) end
	if not state(id, "obj") or state(id, "ransomed") then return false end
	if q.kind == "find" then return diary_lib.count_item(q.item) > 0 end
	return true
end

--' вариант отчёта k доступен?
function choice_ok(id, k)
	local q = get(id)
	local h = hook(id, "choice_ok")
	if h ~= nil then return h(q, k) end
	return true
end

function accept(id)
	local q = get(id)
	set_state(id, "given")
	pcall(function() task_manager.get_task_manager():give_task("dj_" .. id) end)
	diary_news.task_new("dj_" .. id)
	pcall(diary_compass.set_active, "dj_" .. id)
	local h = hook(id, "accept")
	if h ~= nil then
		h(q)
		return
	end
	if q.kind == "kill" then
		for _, s in ipairs(q.squads) do
			local sq = add_squad(id, s[1], s[2])
			local m = sq and diary_lib.squad_leader(sq)
			if m ~= nil then add_spot(id, m) end
		end
		if var(id, "q", 0) == 0 then set_state(id, "obj") end
		if q.captive ~= nil and q.squads[1] ~= nil then
			local sm = diary_lib.smart(q.squads[1][2])
			if sm ~= nil then set_var(id, "cap", diary_lib.create_at_smart(q.captive, sm).id) end
		end
	elseif q.kind == "find" then
		--' метка на район, а не на предмет (Правила: неочевидные цели)
		local sm = spawn_item(q)
		local mark = q.spot and spot_marker(q.spot)
		if mark ~= nil then
			set_var(id, "mark", mark)
			add_spot(id, mark)
		elseif sm ~= nil then add_spot(id, sm.id) end
		for _, s in ipairs(q.ambush) do add_squad(id, s[1], s[2]) end
	elseif q.kind == "deliver" then
		diary_lib.give_items(q.item, 1)
	elseif q.kind == "visit" then
		for _, name in ipairs(q.smarts) do
			local sm = diary_lib.smart(name)
			add_spot(id, sm and sm.id or 0)
		end
	elseif q.kind == "talk" then
		for k, name in ipairs(q.smarts) do
			local sq = add_squad(id, q.talk_squad, name, "t" .. k)
			local m = sq and diary_lib.squad_leader(sq)
			add_spot(id, m or 0)
		end
	end
end

--' Множитель награды: Султан платит вдвое меньше, если пакет вскрыт (последствие "Посылки")
local function reward_mult(q)
	if q.giver == "sul" and q.id ~= "s8" and has("dj_s8_opened") then return 0.5 end
	return 1
end

--' Сдать задание; k - номер варианта отчёта (1..), 0 - без вариантов
function finish(id, k)
	local q = get(id)
	local money, items = q.money, q.reward
	if q.choices ~= nil and k ~= nil and k > 0 then money = q.choices[k] or 0 end
	if q.kind == "give" then
		for _, p in ipairs(q.items) do diary_lib.take_items(p[1], p[2]) end
	elseif (q.kind == "find" or q.kind == "scene") and q.consume and q.item ~= nil then
		diary_lib.take_items(q.item, 1)
	end
	local h = hook(id, "finish")
	if h ~= nil then
		local m = h(q, k)
		if m ~= nil then money = m end
	end
	money = math.floor(money * reward_mult(q))
	--' награда без оповещений (правка 1)
	if money > 0 then db.actor:give_money(money) end
	for _, p in ipairs(items) do diary_lib.give_items(p[1], p[2]) end
	set_state(id, "done")
	set_var(id, "done_t", diary_lib.game_hours())
	clear_spots(id)
	--' за собой не оставляем: засады, переговорщиков, пленных
	if q.kind ~= "kill" or q.captive ~= nil then remove_squads(id) end
	diary_lib.release(var(id, "cap", nil))
	diary_lib.release(var(id, "mark", nil))
	for _, info in ipairs(q.on_done) do give(info) end
	local hc = hook(id, "after_finish")
	if hc ~= nil then hc(q, k) end
end

--' Выкуп пленного вместо боя (k2): заплачено бандитам на месте, Криму остаётся сообщить
function can_alt(id)
	return state(id, "ransomed") and not state(id, "done")
end

function pay_alt(id)
	local q = get(id)
	local m = q.money
	q.money = 0
	finish(id, 0)
	q.money = m
end

--' Цель задания для компаса: id объекта или nil
function target_id(id)
	local q = get(id)
	if q == nil then return nil end
	local h = hook(id, "target")
	if h ~= nil then
		local t = h(q)
		if t ~= nil then return t end
	end
	if not state(id, "obj") then
		if q.kind == "deliver" then return get_story_object_id(q.to) end
		for k = 1, var(id, "n", 0) do
			local sid = var(id, "s" .. k, 0)
			if sid ~= 0 then return sid end
		end
		if q.kind ~= "give" then return nil end
	end
	return get_story_object_id(GIVER[q.giver])
end

--' Задания, которые сейчас взяты (для блокнота)
function active_list()
	local out = {}
	for _, id in ipairs(all()) do
		if state(id, "given") and not state(id, "done") then table.insert(out, "dj_" .. id) end
	end
	return out
end

--' ---- Доставка: получатель принимает предмет (диалог dj_<id>_deliver) ---------------------------
function deliver_here(id, npc)
	local q = get(id)
	if q == nil or not state(id, "given") or state(id, "obj") or state(id, "done") then return false end
	if diary_lib.count_item(q.item) == 0 then return false end
	return npc == nil or npc:id() == get_story_object_id(q.to)
end

function deliver(id)
	local q = get(id)
	diary_lib.take_items(q.item, 1)
	set_state(id, "obj")
	diary_news.task_updated("dj_" .. id, "dj_upd_return")
end

--' ---- Переговоры (talk): NPC из отряда k-й точки ----------------------------------------------
function talk_point(id, npc)
	local q = get(id)
	if q == nil or q.kind ~= "talk" or not state(id, "given") or state(id, "obj") then return nil end
	local sq = diary_lib.npc_squad(npc)
	if sq == nil then return nil end
	for k = 1, #q.smarts do
		if var(id, "t" .. k, -1) == sq and not state(id, "v" .. k) then return k end
	end
	return nil
end

function talk_done(id, k)
	set_state(id, "v" .. k)
	drop_spot(id, k)
end

--' ---- Проверка целей -----------------------------------------------------------------------------
local function objective_reached(id)
	set_state(id, "obj")
	clear_spots(id)
	diary_news.task_updated("dj_" .. id, "dj_upd_return")
end

local function tick_job(id, q)
	local h = hook(id, "tick")
	if h ~= nil then
		h(q)
		return
	end
	local a = db.actor
	if q.kind == "visit" then
		local all_done = true
		for k, name in ipairs(q.smarts) do
			if not state(id, "v" .. k) then
				local sm = diary_lib.smart(name)
				if sm and a:position():distance_to(sm.position) < 45 then
					set_state(id, "v" .. k)
					drop_spot(id, k)
				else
					all_done = false
				end
			end
		end
		if all_done then objective_reached(id) end
	elseif q.kind == "kill" then
		if not squads_alive(id) then objective_reached(id) end
	elseif q.kind == "find" then
		if diary_lib.count_item(q.item) > 0 then objective_reached(id) end
	elseif q.kind == "talk" then
		local all_done = true
		for k = 1, #q.smarts do
			if not state(id, "v" .. k) then all_done = false end
		end
		if all_done then objective_reached(id) end
	end
end

--' ---- Модуль -------------------------------------------------------------------------------------
--' Задание на поиск: на карте блокнота показывается только район, а не место предмета
local SEARCH = {n1 = true, n2 = true, n3 = true, n4 = true, b3 = true, b5 = true, b6 = true}
function is_search(id)
	local q = get(id)
	return q ~= nil and (q.kind == "find" or SEARCH[id] == true)
end

function level_enter()
	load()
	diary_main.safe("jobs_zat.level_enter", diary_jobs_zat.level_enter)
	--' старые сейвы: красные метки заданий убираем с карты
	for _, id in ipairs(ALLQ) do
		for k = 1, var(id, "n", 0) do
			local sid = var(id, "s" .. k, 0)
			if sid ~= 0 then pcall(level.map_remove_object_spot, sid, "red_location") end
		end
	end
end

function update()
	local lvl = level.name()
	for _, id in ipairs(ALLQ) do
		local q = Q[id]
		if q.level == lvl and state(id, "given") and not state(id, "done") then
			if not state(id, "obj") then
				diary_main.safe("job." .. id, tick_job, id, q)
			else
				local h = hook(id, "tick_after")
				if h ~= nil then diary_main.safe("job." .. id .. ".after", h, q) end
			end
		end
	end
	diary_main.safe("jobs_zat.update", diary_jobs_zat.update)
end

--' "Использовать" предмет (вскрыть пакет в "Посылке")
function on_item_use(obj)
	diary_main.safe("jobs.s8_on_use", diary_jobs_zat.s8_on_use, obj)
end
