local MAX_SLOTS = 12

local fx_keep = nil

local function play_portal(pos)
	pcall(function()
		fx_keep = particles_object("anomaly2\\teleport_out_00")
		fx_keep:play_at_pos(pos)
	end)
end

class "tp_panel" (CUIScriptWnd)

function tp_panel:__init() super()
	self:SetWndRect(Frect():set(0,0,1024,768))
	self:Enable(true)
	local xml = CScriptXmlInit()
	xml:ParseFile("diary_tp.xml")
	xml:InitStatic("tp_bg", self)
	xml:InitStatic("tp_title", self)
	self.list = {}
	self.page = 0
	local lvl = level.name()
	for _, pt in ipairs(POINTS) do
		if pt[1] == lvl then
			table.insert(self.list, pt)
		end
	end
	self.btns = {}
	for i = 1, MAX_SLOTS do
		local name = "tp_btn_" .. i
		local b = xml:Init3tButton(name, self)
		self:Register(b, name)
		local idx = i
		self:AddCallback(name, ui_events.BUTTON_CLICKED, function() self:go(self.page * MAX_SLOTS + idx) end, self)
		self.btns[i] = b
	end
	local c = xml:Init3tButton("tp_btn_close", self)
	self:Register(c, "tp_btn_close")
	self:AddCallback("tp_btn_close", ui_events.BUTTON_CLICKED, function() self:HideDialog() end, self)
	self.prev = xml:Init3tButton("tp_btn_prev", self)
	self:Register(self.prev, "tp_btn_prev")
	self:AddCallback("tp_btn_prev", ui_events.BUTTON_CLICKED, function() self:turn(-1) end, self)
	self.next = xml:Init3tButton("tp_btn_next", self)
	self:Register(self.next, "tp_btn_next")
	self:AddCallback("tp_btn_next", ui_events.BUTTON_CLICKED, function() self:turn(1) end, self)
	self:refresh()
end

function tp_panel:pages()
	return math.max(1, math.ceil(#self.list / MAX_SLOTS))
end

function tp_panel:turn(d)
	local p = self.page + d
	if p < 0 or p >= self:pages() then return end
	self.page = p
	self:refresh()
end

function tp_panel:refresh()
	for i = 1, MAX_SLOTS do
		local b = self.btns[i]
		local pt = self.list[self.page * MAX_SLOTS + i]
		if pt ~= nil then
			b:TextControl():SetText(pt[2])
			b:Show(true)
			b:Enable(true)
		else
			b:Show(false)
			b:Enable(false)
		end
	end
	self.prev:Show(self.page > 0)
	self.prev:Enable(self.page > 0)
	self.next:Show(self.page < self:pages() - 1)
	self.next:Enable(self.page < self:pages() - 1)
end

function tp_panel:go(i)
	local pt = self.list[i]
	local a = db.actor
	if pt == nil or a == nil then return end
	local pos = vector():set(pt[3], pt[4], pt[5])
	a:set_actor_position(pos)
	play_portal(pos)
	self:HideDialog()
end

function tp_panel:OnKeyboard(dik, keyboard_action)
	local res = CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
	if res == false then
		if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
			if dik == DIK_keys.DIK_ESCAPE then
				self:HideDialog()
			end
		end
	end
	return res
end

local wanted = nil
local ui = nil

function cancel()
	wanted = nil
end

function request()
	pcall(pos_logger.cancel_panel)
	wanted = time_global()
end

function tick()
	if wanted == nil then return end
	if db.actor == nil then return end
	local busy = false
	local ok, rcv = pcall(function() return level.main_input_receiver() end)
	if ok then
		busy = (rcv ~= nil)
	else
		busy = (time_global() - wanted < 2500)
	end
	if busy then return end
	wanted = nil
	ui = tp_panel()
	ui:ShowDialog(true)
end
