; Дневник проводника: люди заданий ("Лишний рот", "Крыса"). Стоят на месте, с ними можно говорить,
; их можно убить. Отношение к игроку меняет скрипт (diary_jobs_zat).
[logic]
active = remark@stay
can_select_weapon = true

[remark@stay]
anim = guard_na
meet = meet@q
gather_items_enabled = false
help_wounded_enabled = false

[meet@q]
close_anim = nil
close_victim = nil
far_anim = nil
far_victim = nil
close_distance = 0
far_distance = 0
use = {=actor_enemy} false, true
trade_enable = false
allow_break = true
meet_on_talking = false
