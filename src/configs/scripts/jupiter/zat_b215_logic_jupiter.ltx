; Дневник проводника: прибытие на Юпитер и обратная дорога без катсцены (правка 27).
; Лазарь появляется в обычной точке прибытия, а не у начала сцены знакомства;
; инфопорции знакомства выдаются сразу: Лоцман и Азот на своих местах, работы базы Янов открыты.
[logic]
active = sr_idle@control

[sr_idle@control]
on_info1 = {-jup_travel_made -zat_b215_guide_to_zaton} %=teleport_actor(jup_actor_arrive_walk:jup_actor_arrive_look) +jup_travel_made +jup_first_meet_made +jup_b217_welcome_tech_talked +jup_b217_welcome_guide_talked +jup_b217_tech_begin_to_talk%
on_info2 = {+zat_b215_guide_to_zaton +jup_travel_made} sr_idle@to_zat %-jup_travel_made%
on_info3 = {+uni_leave_zone_info} sr_idle@leave_zone %=disable_ui =run_postprocess(fade_in)%

[sr_idle@to_zat]
on_game_timer = 5 | sr_idle@control %=teleport_actor(jup_goto_zaton_walk:jup_goto_zaton_look)%

[sr_idle@leave_zone]
on_game_timer = 20 | nil %=run_tutorial(outro_game)%
