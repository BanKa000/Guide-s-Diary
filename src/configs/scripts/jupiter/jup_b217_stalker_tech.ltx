; Дневник проводника: Азот сразу на своём месте за столом, без сцены знакомства (правка 28).
; Кнопка "Улучшить" - это кнопка торговли в режиме механика, поэтому trade_enable не выключается.
[animpoint@presets]
combat_ignore_cond = true
combat_ignore_keep_when_attacked = true
invulnerable = true
out_restr = jup_a6_sr_noweap
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false
use_camp = false

[logic@jup_b217_stalker_tech]
suitable = {=check_npc_name(jup_b217_stalker_tech)} true
active = animpoint@sit
prior = 200
level_spot = mechanic

[animpoint@sit]:animpoint@presets
cover_name = jup_a6_animpoint_tech
reach_distance = 10
avail_animations = animpoint_sit_normal
meet = meet@default

[meet@default]
close_anim 		= nil
close_victim 	= nil
far_anim 		= nil
far_victim 		= nil
close_distance  = 0
far_distance 	= 0
close_snd_distance = 3
use 			= {!actor_enemy} true, false
allow_break 	= false
close_snd_hello = jup_b217_stalker_tech_greeting
close_snd_bye 	= jup_b217_stalker_tech_farewell
meet_on_talking = false
