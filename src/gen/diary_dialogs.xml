        <phrase_list>
            <phrase id="0"><text>dj_s3_c1_a</text><next>1</next></phrase>
            <phrase id="1"><text>dj_s3_copy_1</text><action>dialogs_diary.s3_copy_start</action><next>2</next></phrase>
            <phrase id="2"><text>dj_s3_copy_2</text><next>3</next></phrase>
            <phrase id="3"><text>dj_s3_copy_3</text></phrase>
        </phrase_list>
    </dialog>
    <dialog id="dj_s3_take" attach="zat_b7_bandit_boss_sultan">
