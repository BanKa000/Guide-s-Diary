            <phrase id="0"><text>dj_s3_take_0</text><next>1</next></phrase>
            <phrase id="1"><text>dj_s3_take_1</text><action>dialogs_diary.s3_copy_take</action></phrase>
        </phrase_list>
    </dialog>
    <dialog id="dj_s3_front" attach="generic">
        <precondition>dialogs_diary.s3_front_here</precondition>
        <phrase_list>
            <phrase id="0"><text>dj_s3_front_0</text><next>1</next></phrase>
            <phrase id="1"><text>dj_s3_front_1</text><action>dialogs_diary.s3_front</action></phrase>
