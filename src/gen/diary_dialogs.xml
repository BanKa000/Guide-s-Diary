<?xml version="1.0" encoding="windows-1251"?>
<!-- Дневник проводника: особые диалоги. diary_build.py вставляет их в dialogs_zaton.xml как есть. -->
<!-- attach="..." - кому добавить actor_dialog (id персонажей через запятую; generic - в character_dialogs.xml) -->
<game_dialogs>

    <!-- Борода: поставки (событие diary_trade, через 1-3 дня) -->
    <dialog id="diary_bor_supply" attach="zat_a2_stalker_barmen">
        <precondition>dialogs_diary.bor_supply_ready</precondition>
        <phrase_list>
            <phrase id="0"><text>diary_bor_supply_0</text><next>1</next></phrase>
            <phrase id="1"><text>diary_bor_supply_1</text><action>dialogs_diary.bor_supply_tell</action></phrase>
        </phrase_list>
    </dialog>

