--------------------------------------------------------------------------------
--' Дневник проводника: функции диалогов (dialogs_zaton.xml, character_dialogs.xml).
--' Как в dialogs_zaton.script: precondition - function(first_speaker, second_speaker) -> bool,
--' action - function(first_speaker, second_speaker). Логика - в модулях diary_*, здесь только вызовы.
--------------------------------------------------------------------------------
local has, give = diary_lib.has, diary_lib.give
local J = diary_jobs
local Z = diary_jobs_zat
local D = diary_debts

local function npc(a, b) return diary_lib.npc_of(a, b) end

--------------------------------------------------------------------------------
--' Борода: блокнот, рассказ о трупе, расшифровка, долги
--------------------------------------------------------------------------------
--' отдаёт блокнот Компаса (предмет в инвентаре, выбросить нельзя)
function give_notebook(first_speaker, second_speaker)
	if db.actor:object("jup_a9_power_info") == nil then diary_lib.give_items("jup_a9_power_info", 1) end
end

--' случайная реплика diary_bor_41..60 без повтора подряд: bor_roll - action фразы 2, bor_line - script_text фразы 41
local BOR_LINES = 20
local bor_n = nil
function bor_roll(first_speaker, second_speaker)
	local n = math.random(BOR_LINES)
	if n == bor_n then n = n % BOR_LINES + 1 end
	bor_n = n
end
function bor_line(first_speaker, second_speaker)
	if bor_n == nil then bor_roll() end
	return game.translate_string("diary_bor_" .. (40 + bor_n))
end

function bor_can_tell(first_speaker, second_speaker)
	return has("diary_q6_given") and not has("diary_cipher_taken")
end
--' рассказ Бороде (q6) закрывается сразу вместе со всеми долгами Компаса (diary_debts_given)
function bor_take_cipher(first_speaker, second_speaker)
	diary_lib.take_items("jup_a9_delivery_info", 1)
	diary_news.thought("diary_news_debts")
end
--' продолжение "Расшифровки" - только после сна
function bor_can_decoded(first_speaker, second_speaker)
	return has("diary_decoded") and not has("diary_cipher_read")
end

--' "Расшифровка": дожидаться можно и не во сне - в разговоре с Бородой ("Посижу тут, подожду")
function bor_wait_open(first_speaker, second_speaker)
	return has("diary_q10_given") and not has("diary_decoded")
end
function bor_wait() diary_story.wait_decode() end

--' поставки: Борода жалуется (событие diary_trade), намекает, что у Сыча и Тремора то же самое
function bor_supply_ready(first_speaker, second_speaker)
	return has("diary_supply_bor_ready") and not has("diary_supply_bor_told")
end
function bor_supply_tell(first_speaker, second_speaker)
	give("diary_supply_bor_told")
	diary_news.record("supply")
end
--' Сыч и Тремор: разговор о поставках после Бороды. Первая просьба открывается только после него
--' (gate в diary_jobs.ltx) и предлагается сразу в этом же разговоре.
function syc_supply_hint(first_speaker, second_speaker)
	return has("diary_supply_bor_told") and not has("diary_supply_syc_told")
end
function syc_supply_tell(first_speaker, second_speaker)
	give("diary_supply_syc_told")
end
function tre_supply_hint(first_speaker, second_speaker)
	return has("diary_supply_bor_told") and not has("diary_supply_tre_told")
end
function tre_supply_tell(first_speaker, second_speaker)
	give("diary_supply_tre_told")
end
--' первая просьба ещё не взята (старые сейвы: могла быть взята до этого разговора)
function y1_free(first_speaker, second_speaker) return not J.state("y1", "given") end
function t1_free(first_speaker, second_speaker) return not J.state("t1", "given") end

--------------------------------------------------------------------------------
--' Долги Компаса Кардану (c) и Сычу (s)
--------------------------------------------------------------------------------
for _, k in ipairs({"c", "s"}) do
	local env = getfenv(1)
	env[k .. "_fresh"]     = function() return D.fresh(k) end
	env[k .. "_rest_open"] = function() return D.rest_open(k) end
	env[k .. "_can_full"]  = function() return D.can_full(k) end
	env[k .. "_can_half"]  = function() return D.can_half(k) end
	env[k .. "_can_rest"]  = function() return D.can_half(k) end
	env[k .. "_has_item"]  = function() return D.has_item(k) end
	env[k .. "_pay_full"]  = function() D.pay_full(k) end
	env[k .. "_pay_half"]  = function() D.pay_half(k) end
	env[k .. "_pay_rest"]  = function() D.pay_rest(k) end
	env[k .. "_pay_item"]  = function() D.pay_item(k) end
	env[k .. "_steal"]     = function() D.steal(k) end
end

--' Султан (1) и Крим (2): "Я насчёт долга Компаса" - в любой момент, и после конца их линий
function deb1_open() return D.deb_open(1) end
function deb1_can_pay() return D.deb_can_pay(1) end
function deb1_pay() D.deb_pay(1) end
function deb2_open() return D.deb_open(2) end
function deb2_can_pay() return D.deb_can_pay(2) end
function deb2_pay() D.deb_pay(2) end

--' наёмник, должный Компасу
function deb3_here(first_speaker, second_speaker) return D.is_debtor(npc(first_speaker, second_speaker)) end
function deb3_take(first_speaker, second_speaker) D.deb3_take() end
function deb3_forgive(first_speaker, second_speaker) D.deb3_forgive() end
function deb3_fight(first_speaker, second_speaker) D.deb3_fight(npc(first_speaker, second_speaker)) end


--' n4: развилка - помочь Бороде (откроется n5) или сразу идти дальше (n5 пропускается)
function n4_yes()
	diary_lib.give("diary_n4_help")
	J.finish("n4", 0)
	if not J.state("n5", "given") then J.accept("n5") end
end
function n4_no() diary_lib.give("diary_n4_nohelp"); J.finish("n4", 0) end

--' n6: какие долги Компаса закрыты (бит 1 Кардан, 2 Сыч, 4 Султан, 8 Крим) - ответ Лазаря и Бороды
do
	local env = getfenv(1)
	local function paid_mask()
		local m = 0
		if diary_lib.has("diary_debt_c_done") then m = m + 1 end
		if diary_lib.has("diary_debt_s_done") then m = m + 2 end
		if diary_lib.has("diary_deb_1_done") then m = m + 4 end
		if diary_lib.has("diary_deb_2_done") then m = m + 8 end
		return m
	end
	for m = 0, 15 do
		env["n6_m" .. m] = function() return paid_mask() == m end
	end
end

--------------------------------------------------------------------------------
--' Задания линий: o_<id> предложить, a_<id> взять, r_<id> отчитаться, d_<id>[_k] сдать,
--' c_<id>_<k> вариант отчёта доступен, l_<id> / p_<id> выкуп вместо задания,
--' dlv_here_<id> / dlv_<id> доставка получателю. Создаются для всех заданий из diary_jobs.ltx.
--------------------------------------------------------------------------------
do
	local env = getfenv(1)
	for _, id in ipairs(J.all()) do
		local q = J.get(id)
		env["o_" .. id] = function() return J.can_offer(id) end
		env["a_" .. id] = function() J.accept(id) end
		env["r_" .. id] = function() return J.can_report(id) end
		env["d_" .. id] = function() J.finish(id, 0) end
		if q.choices ~= nil then
			for k = 1, #q.choices do
				env["c_" .. id .. "_" .. k] = function() return J.can_report(id) and J.choice_ok(id, k) end
				env["d_" .. id .. "_" .. k] = function() J.finish(id, k) end
			end
		end
		if q.alt_pay ~= nil then
			env["l_" .. id] = function() return J.can_alt(id) end
			env["p_" .. id] = function() J.pay_alt(id) end
		end
		if q.kind == "deliver" then
			env["dlv_here_" .. id] = function(a, b) return J.deliver_here(id, npc(a, b)) end
			env["dlv_" .. id] = function() J.deliver(id) end
		end
	end
end

--' "Ложный SOS": бандиты у передатчика и рассказ Бороде о том, что случилось
