--------------------------------------------------------------------------------
--' Дневник проводника: запертые двери.
--' Рядом с игроком снимается запор (ph_door.locked) у запертых дверей, кроме сюжетных
--' из [doors] keep_locked. Двери из [doors] names открываются всегда, как только появляются в онлайне.
--' Открытие: снимается запор (locked, closed) и вызывается open_door самого скрипта двери, если он доступен.
--' Каждая обработанная дверь пишется в diary_errors.log (имя, координаты, поля ph_door).
--------------------------------------------------------------------------------
local logged = {}
local opened = {}       --' id -> true: дверь уже открыта в этой сессии
local scan_t = 0

local function note(msg)
	pcall(function()
		local f = io.open("diary_errors.log", "a")
		if f ~= nil then
			local stamp = ""
			pcall(function() stamp = os.date("%Y-%m-%d %H:%M:%S") end)
			f:write(string.format("[%s] [doors] %s\n", stamp, msg))
			f:close()
		end
	end)
end

local function in_list(list, name)
	for _, n in ipairs(list) do
		if n == name then return true end
	end
	return false
end

--' поля таблицы (числа, строки, булевы) одной строкой
local function dump(t)
	local out = {}
	pcall(function()
		for k, v in pairs(t) do
			local tv = type(v)
			if tv == "number" or tv == "string" or tv == "boolean" then
				table.insert(out, tostring(k) .. "=" .. tostring(v))
			else
				table.insert(out, tostring(k) .. ":" .. tv)
			end
		end
	end)
	table.sort(out)
	return table.concat(out, " ")
end

--' Через скрипт двери: в хранилище ph_door есть door_action (сам обработчик двери) и параметры:
--' locked (заперта), closed (закрыта), tip_open/tip_unlock (надпись), snd_open_* (звуки).
--' Параметры выставляются как у открытой двери, затем обработчик двери открывает её.
local function open_by_action(ph)
	local res = {}
	local da = ph.door_action
	if da == nil then return "no door_action" end
	local function try(name, ...)
		local args = {...}
		local ok, err = pcall(function() return da[name](da, unpack(args)) end)
		table.insert(res, name .. "=" .. tostring(ok) .. (ok and "" or ("(" .. tostring(err) .. ")")))
	end
	try("reset_scheme")
	try("open_door", true)
	return table.concat(res, " ")
end

--' какие секции логики есть у двери (для отладки)
local function logic_info(ph)
	local out = {}
	pcall(function()
		for _, sec in ipairs({"ph_door@unlocked", "ph_door@open", "ph_door@opened", "ph_door@closed", "ph_door@free", "ph_door@normal", "ph_door@unlock"}) do
			if ph.ini:section_exist(sec) then table.insert(out, sec) end
		end
		for i, c in pairs(ph.logic or {}) do
			table.insert(out, "logic[" .. tostring(i) .. "]=" .. tostring(c.name) .. "/" .. tostring(c.p1))
		end
	end)
	return table.concat(out, " ")
end

local function unlock(o, sto, ph, why)
	local id = o:id()
	local p = o:position()
	if not logged[id] then
		logged[id] = true
		note(string.format("%s: %s (%.2f, %.2f, %.2f) ph_door{%s}", why, tostring(o:name()), p.x, p.y, p.z, dump(ph)))
	end
	ph.locked = false
	ph.closed = false
	ph.tip_open = "tip_door_open"
	ph.tip_unlock = "tip_door_open"
	ph.snd_open_start = "trader_door_open_start"
	ph.snd_open_stop = "trader_door_open_stop"
	if not opened[id] then
		opened[id] = true
		local r = open_by_action(ph)
		note(string.format("open %s: %s | %s", tostring(o:name()), r, logic_info(ph)))
	end
end

--' Двери, которые в оригинале открываются инфопорциями квеста (ветка Глухаря, zat_b38: подвал ВНЗ и лифт):
--' рядом с дверью игроку выдаются эти инфопорции, тогда её логика (all.spawn) сама снимает запор.
local function give_open_infos(apos)
	local pt = diary_cfg.point("doors", "info_door")
	if pt == nil then return end
	if apos:distance_to(pt) > diary_cfg.num("doors", "info_radius", 60) then return end
	for _, inf in ipairs(diary_cfg.list("doors", "open_infos")) do
		if not db.actor:has_info(inf) then
			db.actor:give_info_portion(inf)
			note("info given: " .. inf)
		end
	end
end

function level_enter(lvl)
	opened = {}
	scan_t = 0
end

function update(delta)
	local a = db.actor
	if a == nil then return end
	local now = time_global()
	if now < scan_t then return end
	scan_t = now + 1000
	pcall(give_open_infos, a:position())
	local near = diary_cfg.num("doors", "unlock_near", 4)
	local names = diary_cfg.list("doors", "names")
	local keep = diary_cfg.list("doors", "keep_locked")
	local apos = a:position()
	for id, _ in pairs(opened) do
		--' дверь ушла в оффлайн: при следующем появлении логика двери запрёт её заново
		if level.object_by_id(id) == nil then opened[id] = nil end
	end
	for id, sto in pairs(db.storage) do
		local ph = sto and sto.ph_door
		if ph ~= nil and not opened[id] then
			local o = level.object_by_id(id)
			if o ~= nil then
				local name = o:name()
				if in_list(names, name) then
					unlock(o, sto, ph, "open by name")
				elseif near > 0 and ph.locked and o:position():distance_to(apos) <= near and not in_list(keep, name) then
					unlock(o, sto, ph, "open near")
				end
			end
		end
	end
end
