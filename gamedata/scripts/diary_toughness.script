--------------------------------------------------------------------------------
--' Дневник проводника: живучесть наёмников.
--' Наёмники (killer) и бойцы Эгиды получают в factor раз меньше урона ([toughness] в diary_balance.ltx).
--' Модуль следит за здоровьем онлайновых NPC этих группировок и возвращает им долю потерянного:
--' потеряли 20 % при factor = 2 - десять вернулось, итог те же 10 %. Лечение и регенерация не трогаются.
--' Удар, который убивает наповал за один опрос (health <= 0), остаётся смертельным: то, что движок
--' уже убил, скрипт не оживляет.
--------------------------------------------------------------------------------
local kinds = {}      --' id -> true (наша группировка) / false (чужая, не сталкер)
local last = {}       --' id -> здоровье при прошлом опросе
local comms = nil     --' набор группировок из конфига

function level_enter(lvl)
	kinds, last, comms = {}, {}, nil
end

function level_leave()
	kinds, last, comms = {}, {}, nil
end

local function load_comms()
	comms = {}
	for _, c in ipairs(diary_cfg.list("toughness", "communities")) do comms[c] = true end
end

local function ours(npc)
	if not IsStalker(npc) then return false end
	local ok, c = pcall(function() return npc:character_community() end)
	return ok and c ~= nil and comms[c] == true
end

--' back - доля потери, которая возвращается (1 - 1 / factor)
local function strengthen(id, npc, back)
	if not npc:alive() then
		last[id] = nil
		return
	end
	local h = npc.health
	local p = last[id]
	if p ~= nil and h < p and h > 0 then
		h = h + (p - h) * back
		npc.health = h
	end
	last[id] = h
end

function update()
	local f = diary_cfg.num("toughness", "factor", 2)
	if f <= 1 or db.storage == nil then return end
	if comms == nil then load_comms() end
	local back = 1 - 1 / f
	for id, st in pairs(db.storage) do
		local npc = st.object
		if npc ~= nil then
			local k = kinds[id]
			if k == nil then
				local ok, r = pcall(ours, npc)
				k = ok and r or false
				kinds[id] = k
			end
			if k then pcall(strengthen, id, npc, back) end
		end
	end
end
