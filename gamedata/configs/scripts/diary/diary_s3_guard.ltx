; Дневник проводника: хозяева лагеря ("Бумаги из чужого лагеря", s3). Днём стоят у лагеря, с полуночи до пяти утра спят
; (инфопорция dj_s3_sleep включается скриптом diary_jobs_zat). Драка (dj_s3_s3_fight) будит и не даёт уснуть.
[logic]
active = remark@stand
can_select_weapon = true

[remark@stand]
anim = guard_na
meet = meet@stand
on_info = {+dj_s3_sleep -dj_s3_s3_fight} remark@sleep
gather_items_enabled = false
help_wounded_enabled = false

[remark@sleep]
anim = sleep
meet = meet@sleep
on_info = {-dj_s3_sleep} remark@stand
on_info2 = {+dj_s3_s3_fight} remark@stand
combat_ignore_cond = true
combat_ignore_keep_when_attacked = true
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false

[meet@stand]
close_anim = nil
close_victim = nil
far_anim = nil
far_victim = nil
close_distance = 0
far_distance = 0
use = {=actor_enemy} false, true
trade_enable = false
allow_break = true
meet_on_talking = false

[meet@sleep]
close_anim = nil
close_victim = nil
far_anim = nil
far_victim = nil
close_distance = 0
far_distance = 0
use = false
trade_enable = false
allow_break = true
meet_on_talking = false
