; Дневник проводника: бандиты у ложного SOS (b3). Стоят лицом к игроку и не нападают, пока их не тронули;
; отношение меняет скрипт (diary_jobs_zat: b3_escalate). Главаря игрок слушает в разговоре (b3_auto_talk).
[logic]
active = remark@stay
can_select_weapon = true

[remark@stay]
anim = guard_na
target = actor
meet = meet@q
gather_items_enabled = false
help_wounded_enabled = false

[meet@q]
close_anim = nil
close_victim = nil
far_anim = nil
far_victim = nil
close_distance = 0
far_distance = 0
use = {=actor_enemy} false, true
trade_enable = false
allow_break = true
meet_on_talking = false
