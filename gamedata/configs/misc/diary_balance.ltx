; Дневник проводника: баланс. Все цены, таймеры, лимиты и точки - здесь, а не в скриптах.
; Читается через diary_cfg.script. Время в игровых часах, если не сказано иное.

;------------------------------------------------------------------------------
; Общие цены
;------------------------------------------------------------------------------
[prices]
upgrade_mult		= 1.5		; улучшения и ремонт у всех техников (все цены +50%)
merc_mult			= 1.3333	; наёмники (торговец и техник): во столько раз дороже обычной цены (было 4, снижено в 3 раза)
repair_t23			= 5			; ремонт оружия и брони Т2 и Т3 у Кардана и Шурупа: во столько раз дороже
repair_t23_cardan_helped	= 2		; то же у Кардана после помощи ему (все три набора инструментов)
repair_t23_merc		= 5			; то же у техника наёмников (сверх наценки наёмников)

;------------------------------------------------------------------------------
; Сюжет Затона
;------------------------------------------------------------------------------
[job_cooldown]
; Пауза между заданиями одного заказчика (игровые часы). Нет строки или 0 - паузы нет.
; У Сыча, Тремора и Султана пауз между заданиями нет (у Султана задержка только внутри "Бумаг из чужого лагеря", [s3] copy_hours).
; Борода: по сюжету две паузы - "Расшифровка" ([story] decode_sleep_hours = 3, сон в задании) и пауза перед "Чужими следами".
n2					= 12		; Борода: "Чужие следы" - не раньше чем через столько часов после "Хвоста на севере" и не раньше следующего календарного дня

[story]
start_delay			= 8			; через сколько секунд после мысли выдаётся первое задание
decode_sleep_hours	= 3			; "Расшифровка": сон не короче стольких часов
corpse_lifetime		= 8			; секунд держится портал над упавшим трупом

[sawmill]
throw_delay			= 5			; секунд вне тропы до выброса
road_half			= 5			; половина ширины дороги, м
save_near			= 40		; автосохранение, когда до периметра меньше стольких м
save_rearm			= 120		; повторное взведение автосохранения, м

;------------------------------------------------------------------------------
; Долги Компаса
;------------------------------------------------------------------------------
[debts]
c_amount			= 3000		; Кардан
s_amount			= 2500		; Сыч
sultan_amount		= 1500		; Компас должен Султану
krim_amount			= 2000		; Компас должен Криму
merc_amount			= 1200		; наёмник должен Компасу
merc_forgive_rep	= 10		; репутация за прощённый долг

;------------------------------------------------------------------------------
; Экономика: события поставок (в игровых часах)
;------------------------------------------------------------------------------
[supply_zaton]
; Борода заговаривает о поставках, когда игрок после блокнота зашёл к нему в торговлю.
; Если за столько игровых часов так и не зашёл - разговор открывается сам.
bor_fallback		= 72

[supply_jupiter]
gav_stop			= 72		; через 3 дня Гаваец перестаёт продавать оружие, броню и патроны
gav_theft			= 48		; ещё через 2 дня - кража со склада

;------------------------------------------------------------------------------
; Квесты линий: точки, не связанные со смартами (x, y, z). Пусто - берётся смарт квеста.
;------------------------------------------------------------------------------
[plot_places]
; Сюжетные задания Бороды (n1..n6): смарты Затона. Можно заменить на любой смарт из scan_zaton.txt.
n1_antenna		= zat_sim_3			; "Хвост на севере": старая антенна Компаса (север)
n2_place1		= zat_b20_smart_terrain	; "Чужие следы": первое место Компаса
n2_place2		= zat_b42_smart_terrain	; второе место
n2_place3		= zat_a1			; третье место
n2_crate		= zat_sim_15		; ящик с M24 (7,62x51; без пака - СВД) и армейскими аптечками
n3_body			= zat_b101			; "Второй пустой": тело и пост наёмников
n3_wit1			= zat_sim_17		; первый свидетель
n3_wit2			= zat_sim_13		; второй свидетель
n4_stash		= zat_sim_8			; "Последний схрон": запасной смарт, если нет [job_points] n4_stash
n5_point		= zat_sim_11		; "Осложнение": спорная точка Компаса

[job_points]
; b4_thief			= x, y, z, lvid, gvid	; "Лишний рот": где стоит вор (снаружи дома, чтобы к нему можно было подойти; пусто - смарт zat_medic_home_smart)
s4_box				= 213.00, 20.49, 23.91, 1326256, 55	; "Тайник у воды": куда поставить рюкзак (x, y, z, lvid, gvid; пусто - центр смарта)
k5_box				= 167.55, -3.48, -141.43, 1241602, 13	; "Пункт 5": схрон
k5_locator			= 154.86, 20.01, -138.44, 1230701, 13	; "Пункт 5": метка задания (локатор)
k7_guard		= -423.32, 36.29, -383.69, 144017, 306	; "Пункт 7": часовой Монолита у входа в лабораторию
s3_docs			= -283.44, 15.90, 582.62, 373117, 33	; "Бумаги из чужого лагеря": рюкзак с папкой
k7_docs			= -426.56, 26.07, -383.57	; "Пункт 7": записи лаборатории, если их нет на месте
n3_crouch_eye		= 1.5		; "Второй пустой": высота камеры над ногами, ниже которой игрок считается присевшим (стоя ~1,65)
n3_stand_radius	= 3			; "Второй пустой": в халате, но в рост игрока замечают только ближе этого расстояния (м)
n3_ui_grace		= 3			; "Второй пустой": секунд после закрытия инвентаря/сундука, пока сохраняется состояние "крадётся" (в окне игрок встаёт)
n3_sneak_speed		= 1.0		; "Второй пустой": скорость (м/с), ниже которой присевший идёт "шагом" и его не видят
n2_case			= 374.65, -7.00, 367.71, 1586762, 42	; "Следы чужой группы": кейс с оружием 5,56 и армейскими аптечками
n4_stash			= -149.48, 16.74, -159.92, 638609, 307	; "Последний схрон": схрон Компаса у заправки
n3_stash			= -346.30, 8.42, 256.65, 263451, 229	; "Второй пустой": тайник с уликами (сундук)
s5_route1			= zat_b7	; "Крыса": смарт, где он прячется сначала ("Шевченко"). Пусто - сразу на своём смарте
s5_route2			=			; "Крыса": второй смарт ("заправка"). Пусто - сразу на свой смарт zat_sim_8
s6_post			= 430.13, 40.35, -145.20, 1670833, 73	; "Разведчик": место на мосту, откуда наблюдатель смотрит в бинокль (x, y, z, lvid, gvid; пусто - центр смарта zat_b12)
b3_sos	= -391.50, 7.19, 0.00, 191224, 52	; "Ложный SOS": где лежит передатчик и откуда идёт SOS (x, y, z[, lvid, gvid]). Пока свои координаты не заданы - "ВНЗ Круг", вертексы берутся автоматически
b3_trigger	= -396.45, 6.89, -24.76, 183890, 52	; "Ложный SOS": точка на спуске, где игрок с взятым заданием теряет сознание (радиус - [b3] trigger_radius)
b3_scene	= -384.65, 6.90, -17.00, 201577, 52	; "Ложный SOS": куда переносит игрока после потери сознания, бандиты ждут там (x, y, z[, lvid, gvid]). Пусто - игрок остаётся на месте
b5_post	= 349.56, 33.24, -400.75, 1547399, 1	; "Пропавший сталкер": где спит сталкер (станция переработки отходов); вертексы берутся автоматически
s10_spawn	= -170.37, 7.82, 137.74, 601062, 11	; "Самозванцы": где стоит отряд (вокруг на 150 м никого нет)
b6_spawn	= 539.37, 8.99, -290.12, 1819931, 220	; "Химера на юге": где появляется химера (x, y, z[, lvid, gvid]). Пусто - у смарта отряда из diary_jobs.ltx (zat_b33)
s9_room			=			; "Переезд": комната в Лесничестве, где собираются бандиты Султана (x, y, z, lvid, gvid; пусто - центр смарта Лесничества)
s9_meet_time		= 3			; "Переезд": час встречи (по игровому времени): 3:00
s8_inside			= 1500		; "Посылка": сколько денег внутри пакета

[job_prices]
k6_bribe			= 1000		; "Пункт 6": откуп мародёров
k2_ransom			= 3000		; "Пункт 2": выкуп пленного
s9_meet_dist		= 120		; "Переезд": на каком расстоянии от развилки появляются Султан и Борода, м
s9_extra			= 2000		; "Переезд": допплата Лазарю от Султана за согласие пустить его на Скадовск (сверх 4000 из diary_jobs.ltx)

;------------------------------------------------------------------------------
; Задания Бороды
;------------------------------------------------------------------------------
[b3]							; "Ложный SOS"
sos_from			= 12		; SOS в эфире: с какого часа
sos_to				= 18		; по какой час включительно (раз в час)
sos_minutes			= 15		; сколько игровых минут от начала часа сообщение можно услышать
trigger_radius		= 4		; потеря сознания по заданию: на каком расстоянии от b3_trigger, м
sos_radius			= 500		; сообщение приходит, если игрок ближе стольких метров к передатчику
robbery_min			= 5000		; меньше стольких денег у игрока - бандиты забирают и случайное снаряжение (кроме брони)
robbery_items		= 6			; но не больше стольких предметов

[s3]							; "Бумаги из чужого лагеря"
clear_radius		= 150		; в этом радиусе от лагеря на время квеста нет чужих отрядов, м
copy_hours			= 1			; сколько игровых часов Султан переписывает бумаги
plant_radius		= 35		; подбросить копию бумаг можно не дальше этого расстояния от рюкзака, м

[b5]							; "Пропавший сталкер"
find_dist			= 12		; на каком расстоянии от спящего сталкера задание считается выполненным, м

[zaton_tier1]					; Затон: отряды сталкеров и бандитов из симуляции создаются как персонажи 1-го тира (sim_default_*_0)
enabled				= 1			; 0 - выключить, всё как в оригинале
communities			= stalker, bandit	; каких сообществ касается

[b6]							; "Химера на юге"
health				= 0.5		; здоровье химеры (1 - обычное)

;------------------------------------------------------------------------------
; После завершения линий бандитов и наёмников базы пустеют
;------------------------------------------------------------------------------
[base_empty]
delay				= 48		; через сколько игровых часов после конца обеих линий
smarts				= zat_b5_smart_terrain
merc_smart			= zat_b103_merc_smart	; наёмники Цехов уходят отдельно: после ухода Крима
merc_delay			= 48		; через сколько игровых часов после ухода Крима (если он уже ушёл - от первой проверки)

;------------------------------------------------------------------------------
; Живучесть наёмников (diary_toughness.script): урон делится на factor (2 - вдвое живучее, 1 - выключено)
;------------------------------------------------------------------------------
[toughness]
factor				= 2
communities			= killer, aegis		; наёмники и бойцы Эгиды

;------------------------------------------------------------------------------
; Зона (из "Обдумать")
;------------------------------------------------------------------------------
[zone_mood]
period				= 12		; раз во столько часов Зона "меняет настроение" (оповещение)

[surge_calm]
duration			= 3			; аномальное затишье после выброса, часов
chance				= 50		; шанс затишья после выброса, %

[vendetta]
delay_min			= 48		; через сколько часов после убийства важного NPC приходит мститель
delay_max			= 96
squad_chance		= 30		; шанс, что после смерти мстителя выйдет отряд, %
kill_chance			= 25		; шанс мести за обычного (не сюжетного) NPC, %

[rumors]
price				= 300		; цена слуха у обычного сталкера
life				= 24		; срок годности слуха, часов

;------------------------------------------------------------------------------
; Маскировка в заданиях (diary_disguise.script): костюм = группировка героя.
; Меняется, только если в момент переодевания героя не видел никто из охраны.
;------------------------------------------------------------------------------
[disguise]
see_radius			= 80			; "видит" - охранник ближе этого расстояния (м) и смотрит на героя
dj_n3_robe			= camo			; маскхалат ("Второй пустой"): группировка "Маскировка" - все группировки к ней нейтральны
novice_outfit		= stalker		; "Вынос документов": сталкерская броня - лагерь сталкеров не враждебен, если не заметили
stalker_outfit		= stalker

