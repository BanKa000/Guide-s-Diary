; Дневник проводника: пропавший сталкер ("Пропавший сталкер", b5). Спит на месте, не дерётся и не умирает,
; с ним не разговаривают. После находки исчезает (diary_jobs_zat).
[logic]
active = remark@sleep
can_select_weapon = false

[remark@sleep]
anim = sleep
meet = meet@m
combat_ignore_cond = true
combat_ignore_keep_when_attacked = true
invulnerable = true
gather_items_enabled = false
help_wounded_enabled = false
corpse_detection_enabled = false

[meet@m]
close_anim = nil
close_victim = nil
far_anim = nil
far_victim = nil
close_distance = 0
far_distance = 0
use = false
trade_enable = false
allow_break = false
meet_on_talking = false
