;------------------------------------------------------------------------------
; Гаваец: оружие Т1 и часть Т2 (без снайперок), броня Т1, патроны к ним (в том числе бронебойные).
; Автоматные - до 100 (9x39 и 5,56 - до 70), пистолетные - как у Сыча.
; Через 3 дня перестаёт продавать оружие, броню и патроны; после кражи и договора - всё обратно,
; плюс Т2 оружие и броня, снайперские Т2; патроны до 120 (9x39 и 5,56 - до 100).
;------------------------------------------------------------------------------
[gav_food]
bread					= 2, 6
kolbasa					= 2, 6
